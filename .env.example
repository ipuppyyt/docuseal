# Copy to .env on the server (never commit .env)
HOST=sign.example.com
SECRET_KEY_BASE=change-me-run-openssl-rand-hex-64
POSTGRES_PASSWORD=change-me
# Set automatically by the deploy workflow (sha-<commit>). Edit to roll back.
IMAGE_TAG=latest
# Cloudflare tunnel token (Zero Trust > Networks > Tunnels); public hostname -> http://app:3000
TUNNEL_TOKEN=change-me
